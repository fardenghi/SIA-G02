{
  "architecture": [784, 1024, 256, 10],
  "activation": "relu",
  "output_activation": "softmax",
  "loss": "cross_entropy",
  "weight_init": "he",
  "optimizer": "momentum",
  "lr": 0.02,
  "weight_decay": 0.0005,
  "lr_scheduler": {
    "type": "step_decay",
    "decay_rate": 0.5,
    "step_size": 80,
    "lr_min": 1e-5
  },
  "epochs": 600,
  "batch_size": 64,
  "val_split": 0.15,
  "patience": 150,
  "min_delta": 0.0005,
  "seed": 42,
  "data_augmentation": true,
  "aug_rotation_deg": 10,
  "aug_scale_range": [0.9, 1.1],
  "save_model": "outputs/ej3_more_digits/models/arch_wide_sgdm.npz",
  "export_metrics": "outputs/ej3_more_digits/metrics/arch_wide_sgdm.csv"
}
