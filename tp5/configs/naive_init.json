{
  "name": "naive_init",
  "data": { "font_path": "font/font.h", "subset": null },
  "architecture": {
    "encoder_layers": [35, 25, 15, 8, 2],
    "activation": "tanh",
    "output_activation": "sigmoid",
    "init": "normal"
  },
  "training": {
    "optimizer": "adam",
    "loss": "bce",
    "epochs": 20000,
    "lr": 1e-3,
    "restarts": 20,
    "seed": 42,
    "log_every": 200
  },
  "denoising": { "enabled": false },
  "output": { "metrics_csv": "out/naive_init/metrics.csv", "plots_dir": "out/plots" }
}
